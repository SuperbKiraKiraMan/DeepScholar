# Academic Research Copilot 安全配置模板
# 复制为 .env 后按需填写；真实密钥只保存在本机，绝不要提交 .env。

# ---- 应用 ----
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- Agent 与模型 ----
# rule + mock 可在没有网络和 API Key 时运行演示与测试。
AGENT_MODE=rule
LLM_ONLY_MODE=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
MAX_TOOL_CALLS=8
SEARCH_MAX_TOOL_CALLS=4
SEARCH_WORKER_TIMEOUT_MS=75000
SEARCH_TOOL_TIMEOUT_MS=30000
RESEARCH_LATENCY_TTL_SECONDS=180

# ---- 学术搜索 ----
# mock：离线 fixture；academic：项目内置 provider；openalex：OpenAlex API。
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_CONTENT_BASE_URL=https://content.openalex.org
OPENALEX_TIMEOUT_SECONDS=15
OPENALEX_MAX_RETRIES=2
OPENALEX_FALLBACK_TO_MOCK=false
OPENALEX_CONTENT_MODE=abstract
OPENALEX_MAX_CONTENT_FETCHES=3
OPENALEX_MAX_TEXT_CHARS=30000
RUN_OPENALEX_LIVE=false

# ---- 本地论文检索（可选） ----
# 使用通用占位路径；请替换为自己的只读 Zotero storage 目录。
ZOTERO_STORAGE_PATH=/path/to/zotero/storage
LOCAL_RAG_ENABLED=false
LOCAL_RAG_HYBRID_ENABLED=true
LOCAL_RAG_EMBEDDING_PROVIDER=bge-m3
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=auto
BGE_M3_BATCH_SIZE=16
BGE_M3_MAX_LENGTH=8192
BGE_M3_NORMALIZE_EMBEDDINGS=true
BGE_M3_CACHE_DIR=data/models
BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BGE_M3_LOCAL_FILES_ONLY=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=local_papers_bge_m3_v4
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFER_GRPC=false
QDRANT_BATCH_SIZE=64
LOCAL_RAG_INDEX_SCHEMA_VERSION=v4-section-quality-reference-boundary-late-signal
LOCAL_RAG_CHUNK_SIZE=900
LOCAL_RAG_CHUNK_OVERLAP=120
LOCAL_RAG_MIN_SCORE=0.25

# ---- Semantic Scholar（可选） ----
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_GRAPH_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_RECOMMENDATIONS_BASE_URL=https://api.semanticscholar.org/recommendations/v1
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=20
SEMANTIC_SCHOLAR_MAX_RETRIES=2
SEMANTIC_SCHOLAR_RATE_LIMIT_RETRIES=6
SEMANTIC_SCHOLAR_MAX_RETRY_WAIT_SECONDS=45
RUN_SEMANTIC_SCHOLAR_LIVE=false

# ---- MCP（默认关闭） ----
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp_servers.json
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_FAIL_OPEN=true
MCP_ALLOWED_SERVERS=
MCP_ALLOW_INSECURE_HTTP=false
CROSSREF_MAILTO=
CROSSREF_BASE_URL=https://api.crossref.org/works
CROSSREF_TIMEOUT_SECONDS=15
LOCAL_RAG_ENDPOINT=
LOCAL_RAG_TIMEOUT_SECONDS=20

# ---- 运行历史与会话 ----
RUN_HISTORY_ENABLED=true
SQLITE_DB_PATH=data/research_history.db
SQLITE_BUSY_TIMEOUT_MS=5000
PROMPT_VERSION=v1
SESSION_TTL_MINUTES=30
CONVERSATION_DATA_DIR=.
USER_MEMORY_DIR=.memory
CONTEXT_TOOL_RESULT_BUDGET_BYTES=204800
CONTEXT_SINGLE_TOOL_RESULT_BYTES=30720
CONTEXT_PERSISTED_PREVIEW_CHARS=2000
CONTEXT_MAX_MESSAGES=30
CONTEXT_KEEP_HEAD_MESSAGES=6
CONTEXT_KEEP_TAIL_MESSAGES=24
CONTEXT_RECENT_TOOL_RESULTS=5
CONTEXT_L4_TOKEN_THRESHOLD=8000
CONTEXT_L4_MIN_TURNS=10
CONTEXT_L4_TURN_GAP=5

# ---- 可选评测服务 ----
DEEPEVAL_API_KEY=
